---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
---

<Layout title={`Gallery | ${config.site.title}`} description="Photo gallery">
  <Header />
  <Breadcrumb />

  <Main pageTitle="Gallery">
  <div id="gallery-status" class="py-12 text-center text-muted-foreground">
    Loading...
  </div>

  <!-- 行优先瀑布流容器 -->
  <div id="gallery" class="relative hidden">
  </div>
</Main>

  <Footer />
</Layout>

<!-- Lightbox overlay -->
<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-skin-bg/95 p-4 backdrop-blur-sm"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
>
  <button
    id="lightbox-close"
    class="absolute right-4 top-4 size-10 text-skin-base/70 hover:text-skin-accent"
    aria-label="Close lightbox"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  <img id="lightbox-img" src="" alt="" class="max-h-[85vh] max-w-full object-contain rounded-md" />
</div>

<script>
  const gallery = document.getElementById("gallery");
  const statusEl = document.getElementById("gallery-status");
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");
  const lightboxClose = document.getElementById("lightbox-close");

  // 已计算好尺寸的图片缓存
  const imageMetaList = [];
  let rawImageList = [];
  const CONCURRENT_LIMIT = 4;
  let loadIndex = 0;
  let colHeights = [];
  const gap = 16;
  // 布局锁：防止并发加载时同时修改列高
  let layoutLock = false;

  const getColumnCount = () => {
    const w = window.innerWidth;
    if (w >= 1024) return 4;
    if (w >= 640) return 3;
    return 2;
  };

  // ========== 灯箱逻辑 ==========
  function openLightbox(src, alt) {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    lightbox.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }
  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    lightbox.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }
  lightboxClose?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", e => e.target === lightbox && closeLightbox());
  document.addEventListener("keydown", e => e.key === "Escape" && closeLightbox());

  // ========== 预加载图片尺寸（仅加载尺寸，不渲染） ==========
  function preloadImgSize(url) {
    return new Promise((resolve) => {
      const img = new Image();
      img.onload = () => resolve({
        naturalW: img.naturalWidth,
        naturalH: img.naturalHeight
      });
      img.onerror = () => resolve({ naturalW: 400, naturalH: 300 });
      img.src = url;
    });
  }

  // ========== 单张图片安全插入（带布局锁） ==========
  function appendImage(item) {
    if (!gallery || layoutLock) return;
    layoutLock = true;

    const colCount = getColumnCount();
    const containerWidth = gallery.offsetWidth;
    const itemWidth = (containerWidth - gap * (colCount - 1)) / colCount;
    const scale = itemWidth / item.naturalW;
    const itemHeight = item.naturalH * scale;

    // 找到最矮列
    const minHeight = Math.min(...colHeights);
    const colIndex = colHeights.indexOf(minHeight);

    const btn = document.createElement("button");
    btn.className = "group absolute overflow-hidden rounded-lg border border-border bg-card transition-all duration-200 hover:border-accent/60 hover:shadow-sm";
    btn.style.width = `${itemWidth}px`;
    btn.style.height = `${itemHeight}px`;
    btn.style.left = `${colIndex * (itemWidth + gap)}px`;
    btn.style.top = `${minHeight}px`;
    btn.style.opacity = "0";
    btn.dataset.src = item.url;
    btn.dataset.name = item.name;
    btn.setAttribute("aria-label", `View ${item.name}`);

    const img = document.createElement("img");
    img.src = item.url;
    img.alt = item.name;
    // 移除原生懒加载，避免滚动触发高度突变
    img.className = "w-full h-full object-cover block transition-transform duration-300 group-hover:scale-105";
    btn.appendChild(img);

    btn.addEventListener("click", () => openLightbox(item.url, item.name));
    gallery.appendChild(btn);

    // 淡入动画
    requestAnimationFrame(() => {
      btn.style.transition = "opacity 0.3s ease";
      btn.style.opacity = "1";
    });

    // 更新列高与容器高度
    colHeights[colIndex] = minHeight + itemHeight + gap;
    gallery.style.height = `${Math.max(...colHeights)}px`;

    layoutLock = false;
  }

  // ========== 全量重排（缩放/滚动结束校准用） ==========
  function reRenderAll() {
    if (!gallery || imageMetaList.length === 0 || layoutLock) return;
    layoutLock = true;
    gallery.innerHTML = "";

    const colCount = getColumnCount();
    const containerWidth = gallery.offsetWidth;
    const itemWidth = (containerWidth - gap * (colCount - 1)) / colCount;
    colHeights = new Array(colCount).fill(0);

    imageMetaList.forEach(item => {
      const scale = itemWidth / item.naturalW;
      const itemHeight = item.naturalH * scale;
      const minHeight = Math.min(...colHeights);
      const colIndex = colHeights.indexOf(minHeight);

      const btn = document.createElement("button");
      btn.className = "group absolute overflow-hidden rounded-lg border border-border bg-card transition-all duration-200 hover:border-accent/60 hover:shadow-sm";
      btn.style.width = `${itemWidth}px`;
      btn.style.height = `${itemHeight}px`;
      btn.style.left = `${colIndex * (itemWidth + gap)}px`;
      btn.style.top = `${minHeight}px`;
      btn.setAttribute("aria-label", `View ${item.name}`);

      const img = document.createElement("img");
      img.src = item.url;
      img.alt = item.name;
      img.className = "w-full h-full object-cover block transition-transform duration-300 group-hover:scale-105";
      btn.appendChild(img);

      btn.addEventListener("click", () => openLightbox(item.url, item.name));
      gallery.appendChild(btn);

      colHeights[colIndex] = minHeight + itemHeight + gap;
    });

    gallery.style.height = `${Math.max(...colHeights)}px`;
    layoutLock = false;
  }

  // ========== 并发加载调度 ==========
  function loadNext() {
    if (loadIndex >= rawImageList.length) {
      // 全部加载完成后，最终校准一次布局
      setTimeout(reRenderAll, 100);
      return;
    }

    const current = loadIndex++;
    const item = rawImageList[current];

    preloadImgSize(item.url).then(meta => {
      const fullItem = { ...item, ...meta };
      imageMetaList.push(fullItem);
      appendImage(fullItem);
      loadNext();
    });
  }

  // ========== 滚动防抖校准 ==========
  let scrollTimer;
  window.addEventListener("scroll", () => {
    clearTimeout(scrollTimer);
    scrollTimer = setTimeout(() => {
      // 滚动停止后，统一校准一次布局，消除滚动中可能的微小错位
      if (!gallery.classList.contains("hidden")) {
        reRenderAll();
      }
    }, 150);
  }, { passive: true });

  // ========== 窗口缩放重排 ==========
  let resizeTimer;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      if (!gallery.classList.contains("hidden")) reRenderAll();
    }, 200);
  });

  // ========== 初始化 ==========
  async function loadGallery() {
    if (!gallery || !statusEl) return;
    try {
      loadIndex = 0;
      rawImageList = [];
      imageMetaList.length = 0;
      layoutLock = false;

      const res = await fetch("/api/gallery/");
      if (!res.ok) throw new Error(`API error: ${res.status}`);
      rawImageList = await res.json();

      if (!Array.isArray(rawImageList) || rawImageList.length === 0) {
        statusEl.textContent = "No images yet.";
        return;
      }

      statusEl.classList.add("hidden");
      gallery.classList.remove("hidden");

      // 等待DOM布局生效
      await new Promise(resolve => requestAnimationFrame(resolve));

      colHeights = new Array(getColumnCount()).fill(0);
      // 启动并发加载
      for (let i = 0; i < CONCURRENT_LIMIT; i++) {
        loadNext();
      }

    } catch (e) {
      console.error("Gallery load error:", e);
      statusEl.textContent = "Failed to load gallery.";
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadGallery);
  } else loadGallery();
  document.addEventListener("astro:page-load", loadGallery);
</script>